{
  "name": "@signett/eval",
  "version": "0.1.2",
  "description": "Portable evaluations and headless WebMCP agent testing for agent-ready websites.",
  "type": "module",
  "bin": {
    "signett": "cli.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./agent": {
      "types": "./agent.d.mts",
      "import": "./agent.mjs"
    },
    "./cli": "./cli.mjs"
  },
  "files": [
    "*.d.ts",
    "*.d.mts",
    "*.mjs",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signettai/signett.git",
    "directory": "packages/eval"
  },
  "homepage": "https://signett.ai",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webmcp",
    "agents",
    "evals",
    "browser",
    "evidence"
  ],
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "ws": "^8.18.3"
  }
}
